generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [citext]
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

enum PlatformRole {
  PLATFORM_SUPER_ADMIN
  PLATFORM_INSTITUTION_REVIEWER
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  UNIVERSITY
  COACHING
  OTHER
}

enum RegistrationRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum InstitutionStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LEFT
}

enum InvitationType {
  ADMIN
  STUDENT
  TEACHER
  STAFF
}

enum InvitationStatus {
  PENDING
  CLAIMED
  EXPIRED
  REVOKED
}

enum PersonType {
  STUDENT
  TEACHER
  STAFF
}

enum OnboardingStatus {
  DRAFT
  READY
  INVITED
  CLAIMED
  CANCELLED
}

enum EmployeeType {
  TEACHER
  ADMINISTRATIVE_STAFF
  ACCOUNTANT
  LIBRARIAN
  LAB_ASSISTANT
  SUPPORT_STAFF
  OTHER
}

enum EntityStatus {
  ACTIVE
  SUSPENDED
  LEFT
}

enum AcademicStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ChallengePurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
}

model User {
  userId          String     @id @default(uuid()) @map("user_id") @db.Uuid
  email           String     @unique(map: "uq_users_email") @db.Citext
  phone           String?    @unique(map: "uq_users_phone") @db.VarChar(32)
  passwordHash    String     @map("password_hash")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile                       UserProfile?
  platformRoles                 PlatformUserRole[]
  submittedRegistrationRequests InstitutionRegistrationRequest[] @relation("RegistrationSubmitter")
  reviewedRegistrationRequests  InstitutionRegistrationRequest[] @relation("RegistrationReviewer")
  memberships                   InstitutionMembership[]
  claimedInvitations            Invitation[]                     @relation("InvitationClaimant")
  claimedOnboardingRecords      OnboardingRecord[]               @relation("OnboardingClaimant")
  students                      Student[]
  employees                     Employee[]
  auditEntries                  AuditLog[]
  refreshSessions               RefreshSession[]
  verificationChallenges        VerificationChallenge[]

  @@map("users")
}

model UserProfile {
  userId             String    @id @map("user_id") @db.Uuid
  firstName          String    @map("first_name") @db.VarChar(100)
  middleName         String?   @map("middle_name") @db.VarChar(100)
  lastName           String    @map("last_name") @db.VarChar(100)
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  gender             String?   @db.VarChar(32)
  profilePhotoFileId String?   @map("profile_photo_file_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_profiles")
}

model PlatformUserRole {
  userId    String       @map("user_id") @db.Uuid
  role      PlatformRole
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, role])
  @@map("platform_user_roles")
}

model Board {
  boardId     String   @id @default(uuid()) @map("board_id") @db.Uuid
  boardCode   String   @unique @map("board_code") @db.VarChar(50)
  displayName String   @map("display_name") @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  institutions         Institution[]
  registrationRequests InstitutionRegistrationRequest[]

  @@map("boards")
}

model InstitutionRegistrationRequest {
  requestId             String                    @id @default(uuid()) @map("request_id") @db.Uuid
  submittedByUserId     String                    @map("submitted_by_user_id") @db.Uuid
  institutionName       String                    @map("institution_name") @db.VarChar(250)
  institutionType       InstitutionType           @map("institution_type")
  boardId               String?                   @map("board_id") @db.Uuid
  registrationNumber    String?                   @map("registration_number") @db.VarChar(100)
  officialEmail         String                    @map("official_email") @db.Citext
  officialPhone         String                    @map("official_phone") @db.VarChar(32)
  addressLine1          String                    @map("address_line_1") @db.VarChar(250)
  addressLine2          String?                   @map("address_line_2") @db.VarChar(250)
  city                  String                    @db.VarChar(100)
  state                 String                    @db.VarChar(100)
  postalCode            String                    @map("postal_code") @db.VarChar(20)
  country               String                    @db.VarChar(2)
  proofFileId           String?                   @map("proof_file_id") @db.Uuid
  status                RegistrationRequestStatus @default(PENDING)
  reviewedByUserId      String?                   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt            DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason       String?                   @map("rejection_reason") @db.VarChar(1000)
  approvedInstitutionId String?                   @unique @map("approved_institution_id") @db.Uuid
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  submittedByUser     User         @relation("RegistrationSubmitter", fields: [submittedByUserId], references: [userId], onDelete: Restrict)
  reviewedByUser      User?        @relation("RegistrationReviewer", fields: [reviewedByUserId], references: [userId], onDelete: Restrict)
  board               Board?       @relation(fields: [boardId], references: [boardId], onDelete: Restrict)
  approvedInstitution Institution? @relation("ApprovedInstitution", fields: [approvedInstitutionId], references: [institutionId], onDelete: Restrict)

  @@index([submittedByUserId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("institution_registration_requests")
}

model Institution {
  institutionId   String            @id @default(uuid()) @map("institution_id") @db.Uuid
  institutionCode String            @unique @map("institution_code") @db.VarChar(40)
  institutionName String            @map("institution_name") @db.VarChar(250)
  institutionType InstitutionType   @map("institution_type")
  boardId         String?           @map("board_id") @db.Uuid
  status          InstitutionStatus @default(ACTIVE)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  board                     Board?                          @relation(fields: [boardId], references: [boardId], onDelete: Restrict)
  registrationRequest       InstitutionRegistrationRequest? @relation("ApprovedInstitution")
  memberships               InstitutionMembership[]
  invitations               Invitation[]
  onboardingRecords         OnboardingRecord[]
  studentOnboardingDetails  StudentOnboardingDetail[]
  employeeOnboardingDetails EmployeeOnboardingDetail[]
  students                  Student[]
  employees                 Employee[]
  academicSessions          AcademicSession[]
  classSections             ClassSection[]
  auditEntries              AuditLog[]

  @@index([status])
  @@map("institutions")
}

model InstitutionMembership {
  membershipId  String           @id @default(uuid()) @map("membership_id") @db.Uuid
  institutionId String           @map("institution_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  status        MembershipStatus @default(PENDING)
  joinedAt      DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt        DateTime?        @map("left_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution        Institution        @relation(fields: [institutionId], references: [institutionId], onDelete: Restrict)
  user               User               @relation(fields: [userId], references: [userId], onDelete: Restrict)
  roles              MembershipRole[]   @relation("MembershipRoles")
  assignedRoles      MembershipRole[]   @relation("RoleAssigner")
  createdInvitations Invitation[]
  createdOnboarding  OnboardingRecord[]
  auditEntries       AuditLog[]

  @@unique([institutionId, userId])
  @@index([userId, status])
  @@index([institutionId, status])
  @@map("institution_memberships")
}

model Role {
  roleId      String   @id @default(uuid()) @map("role_id") @db.Uuid
  roleCode    String   @unique @map("role_code") @db.VarChar(50)
  displayName String   @map("display_name") @db.VarChar(100)
  description String   @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions RolePermission[]
  memberships MembershipRole[]
  invitations Invitation[]

  @@map("roles")
}

model Permission {
  permissionId   String @id @default(uuid()) @map("permission_id") @db.Uuid
  permissionCode String @unique @map("permission_code") @db.VarChar(100)
  description    String @db.VarChar(500)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [permissionId], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId           String   @map("membership_id") @db.Uuid
  roleId                 String   @map("role_id") @db.Uuid
  assignedByMembershipId String?  @map("assigned_by_membership_id") @db.Uuid
  assignedAt             DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  membership InstitutionMembership  @relation("MembershipRoles", fields: [membershipId], references: [membershipId], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [roleId], onDelete: Restrict)
  assignedBy InstitutionMembership? @relation("RoleAssigner", fields: [assignedByMembershipId], references: [membershipId], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_roles")
}

model Invitation {
  invitationId          String           @id @default(uuid()) @map("invitation_id") @db.Uuid
  institutionId         String           @map("institution_id") @db.Uuid
  invitationType        InvitationType   @map("invitation_type")
  email                 String?          @db.Citext
  phone                 String?          @db.VarChar(32)
  targetRoleId          String?          @map("target_role_id") @db.Uuid
  onboardingRecordId    String?          @unique @map("onboarding_record_id") @db.Uuid
  tokenHash             String           @unique @map("token_hash") @db.Char(64)
  status                InvitationStatus @default(PENDING)
  expiresAt             DateTime         @map("expires_at") @db.Timestamptz(6)
  claimedAt             DateTime?        @map("claimed_at") @db.Timestamptz(6)
  claimedByUserId       String?          @map("claimed_by_user_id") @db.Uuid
  createdByMembershipId String?          @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution      Institution            @relation(fields: [institutionId], references: [institutionId], onDelete: Restrict)
  targetRole       Role?                  @relation(fields: [targetRoleId], references: [roleId], onDelete: Restrict)
  onboardingRecord OnboardingRecord?      @relation(fields: [onboardingRecordId], references: [onboardingId], onDelete: Restrict)
  claimedByUser    User?                  @relation("InvitationClaimant", fields: [claimedByUserId], references: [userId], onDelete: Restrict)
  createdBy        InstitutionMembership? @relation(fields: [createdByMembershipId], references: [membershipId], onDelete: Restrict)

  @@index([institutionId, status, createdAt(sort: Desc)])
  @@index([email, status])
  @@index([phone, status])
  @@map("invitations")
}

model OnboardingRecord {
  onboardingId          String           @id @default(uuid()) @map("onboarding_id") @db.Uuid
  institutionId         String           @map("institution_id") @db.Uuid
  personType            PersonType       @map("person_type")
  firstName             String           @map("first_name") @db.VarChar(100)
  middleName            String?          @map("middle_name") @db.VarChar(100)
  lastName              String           @map("last_name") @db.VarChar(100)
  email                 String?          @db.Citext
  phone                 String?          @db.VarChar(32)
  dateOfBirth           DateTime?        @map("date_of_birth") @db.Date
  status                OnboardingStatus @default(DRAFT)
  createdByMembershipId String           @map("created_by_membership_id") @db.Uuid
  claimedByUserId       String?          @map("claimed_by_user_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution     Institution               @relation(fields: [institutionId], references: [institutionId], onDelete: Restrict)
  createdBy       InstitutionMembership     @relation(fields: [createdByMembershipId], references: [membershipId], onDelete: Restrict)
  claimedBy       User?                     @relation("OnboardingClaimant", fields: [claimedByUserId], references: [userId], onDelete: Restrict)
  studentDetails  StudentOnboardingDetail?
  employeeDetails EmployeeOnboardingDetail?
  invitation      Invitation?

  @@index([institutionId, status, createdAt(sort: Desc)])
  @@index([institutionId, personType, status])
  @@map("onboarding_records")
}

model StudentOnboardingDetail {
  onboardingId      String   @id @map("onboarding_id") @db.Uuid
  institutionId     String   @map("institution_id") @db.Uuid
  admissionNumber   String   @map("admission_number") @db.VarChar(100)
  academicSessionId String   @map("academic_session_id") @db.Uuid
  classSectionId    String   @map("class_section_id") @db.Uuid
  guardianName      String?  @map("guardian_name") @db.VarChar(200)
  guardianPhone     String?  @map("guardian_phone") @db.VarChar(32)
  admissionDate     DateTime @map("admission_date") @db.Date

  onboardingRecord OnboardingRecord @relation(fields: [onboardingId], references: [onboardingId], onDelete: Cascade)
  institution      Institution      @relation(fields: [institutionId], references: [institutionId], onDelete: Restrict)
  academicSession  AcademicSession  @relation(fields: [academicSessionId], references: [academicSessionId], onDelete: Restrict)
  classSection     ClassSection     @relation(fields: [classSectionId], references: [classSectionId], onDelete: Restrict)

  @@unique([institutionId, admissionNumber])
  @@index([institutionId, academicSessionId, classSectionId])
  @@map("student_onboarding_details")
}

model EmployeeOnboardingDetail {
  onboardingId   String       @id @map("onboarding_id") @db.Uuid
  institutionId  String       @map("institution_id") @db.Uuid
  employeeNumber String       @map("employee_number") @db.VarChar(100)
  employeeType   EmployeeType @map("employee_type")
  designation    String?      @db.VarChar(150)
  department     String?      @db.VarChar(150)
  joiningDate    DateTime     @map("joining_date") @db.Date

  onboardingRecord OnboardingRecord @relation(fields: [onboardingId], references: [onboardingId], onDelete: Cascade)
  institution      Institution      @relation(fields: [institutionId], references: [institutionId], onDelete: Restrict)

  @@unique([institutionId, employeeNumber])
  @@index([institutionId, employeeType])
  @@map("employee_onboarding_details")
}

model Student {
  studentId       String       @id @default(uuid()) @map("student_id") @db.Uuid
  institutionId   String       @map("institution_id") @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  admissionNumber String       @map("admission_number") @db.VarChar(100)
  status          EntityStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution Institution @relation(fields: [institutionId], references: [institutionId], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@unique([institutionId, userId])
  @@unique([institutionId, admissionNumber])
  @@index([institutionId, status])
  @@map("students")
}

model Employee {
  employeeId     String       @id @default(uuid()) @map("employee_id") @db.Uuid
  institutionId  String       @map("institution_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  employeeNumber String       @map("employee_number") @db.VarChar(100)
  employeeType   EmployeeType @map("employee_type")
  designation    String?      @db.VarChar(150)
  department     String?      @db.VarChar(150)
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution Institution @relation(fields: [institutionId], references: [institutionId], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@unique([institutionId, userId])
  @@unique([institutionId, employeeNumber])
  @@index([institutionId, employeeType, status])
  @@map("employees")
}

model AcademicSession {
  academicSessionId String         @id @default(uuid()) @map("academic_session_id") @db.Uuid
  institutionId     String         @map("institution_id") @db.Uuid
  name              String         @db.VarChar(50)
  startDate         DateTime       @map("start_date") @db.Date
  endDate           DateTime       @map("end_date") @db.Date
  status            AcademicStatus @default(DRAFT)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution              Institution               @relation(fields: [institutionId], references: [institutionId], onDelete: Restrict)
  classSections            ClassSection[]
  studentOnboardingDetails StudentOnboardingDetail[]

  @@unique([institutionId, name])
  @@index([institutionId, status])
  @@map("academic_sessions")
}

model ClassSection {
  classSectionId    String         @id @default(uuid()) @map("class_section_id") @db.Uuid
  institutionId     String         @map("institution_id") @db.Uuid
  academicSessionId String         @map("academic_session_id") @db.Uuid
  classLevel        String         @map("class_level") @db.VarChar(50)
  section           String         @db.VarChar(20)
  stream            String?        @db.VarChar(100)
  status            AcademicStatus @default(ACTIVE)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution              Institution               @relation(fields: [institutionId], references: [institutionId], onDelete: Restrict)
  academicSession          AcademicSession           @relation(fields: [academicSessionId], references: [academicSessionId], onDelete: Restrict)
  studentOnboardingDetails StudentOnboardingDetail[]

  @@unique([institutionId, academicSessionId, classLevel, section, stream])
  @@index([institutionId, academicSessionId, status])
  @@map("class_sections")
}

model AuditLog {
  auditId           String   @id @default(uuid()) @map("audit_id") @db.Uuid
  institutionId     String?  @map("institution_id") @db.Uuid
  actorUserId       String   @map("actor_user_id") @db.Uuid
  actorMembershipId String?  @map("actor_membership_id") @db.Uuid
  action            String   @db.VarChar(150)
  entityType        String   @map("entity_type") @db.VarChar(100)
  entityId          String   @map("entity_id") @db.Uuid
  metadata          Json     @default("{}") @db.JsonB
  ipAddress         String?  @map("ip_address") @db.Inet
  userAgent         String?  @map("user_agent") @db.VarChar(500)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  institution     Institution?           @relation(fields: [institutionId], references: [institutionId], onDelete: Restrict)
  actorUser       User                   @relation(fields: [actorUserId], references: [userId], onDelete: Restrict)
  actorMembership InstitutionMembership? @relation(fields: [actorMembershipId], references: [membershipId], onDelete: Restrict)

  @@index([institutionId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model RefreshSession {
  sessionId           String    @id @default(uuid()) @map("session_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash") @db.Char(64)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid
  userAgent           String?   @map("user_agent") @db.VarChar(500)
  ipAddress           String?   @map("ip_address") @db.Inet
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model VerificationChallenge {
  challengeId String           @id @default(uuid()) @map("challenge_id") @db.Uuid
  userId      String?          @map("user_id") @db.Uuid
  email       String?          @db.Citext
  phone       String?          @db.VarChar(32)
  purpose     ChallengePurpose
  tokenHash   String           @unique @map("token_hash") @db.Char(64)
  attempts    Int              @default(0)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime?        @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([email, purpose, createdAt(sort: Desc)])
  @@index([phone, purpose, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("verification_challenges")
}
